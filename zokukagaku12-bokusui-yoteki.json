 "poems": [
  {
   "seq": "1",
   "text": "誓てこのありがたき聖慮お報いたてまつらんことを、",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "ヽしきとざなれバ師あこひて再講を煩はし筆記しおくものならし",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "·と人たちより傳へうけたまはりかゝる金玉の說を世お殘しおかぬもくちを",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "明治十六年一月六日御講書始お進講したまひけるを",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "兩陛下ふのく叡感まし〓〓けるよしを御かたはらゐ侍らひて陪聽せしおも",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "紀のうみのふのきこゝろをとめかねて",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "あまりにもおぼろになれる月夜哉かすむい春の習と思へと",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "ゆふがらす聲のみ歸る外山より霞〓ははゝもいづる月おな",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "鶯のなきくらしたる山べよりおほひていづるはる比夜の月",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "關守比うちぬる夜半に風こえてさくらちりしく足柄せやま",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "一ひら北ちるざにをしき花をみな風の誘ふにまかすべき哉",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "まち〓〓しほどい千とせ比櫻花ちるゆふべふも成にける哉、",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "柴人の折そへて來る花みれがおほはら山いさきにけるかを",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "枝ながら嵐も花いさそはじをにくきい人の手折るなりけり",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "白かね比めぬきの太刀の紐ときて花見る時い利でころもなし",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "ゆくりむく高根迄こそ登りけれふもと比蕨をるとせし間に",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "いさゝうも世にいなびあぬかくれグ比門比柳ふ春風ぞふく",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "もえ初ていく日もあふぬ玉柳なびくばろりお早おりにりて",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "世の中にいちはやくしてめでたきい先さく梅の心なりけり",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "枝うごく松も〓水に影みえて風をさへくむあゝちこそすれ",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "くれはてぬほどどにくらき北山のやま澤水にくひな鳴なり",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "すむいたゞ狐こだまとみしやどにある人がや北夕おやお花",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "風ふけバ凉しくなびく庭草をいぶせしとのみ思ひけるかな",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "花さくもほどなくなれる夏草を滋ちかさ人の來てい苅る哉",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "水上にふねこぎゆりバ墨田川いよ〓〓月ハすヾしかりけり",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "けさみれパ憎くもあらずよべ比市お𛁈ひて賣られし撫子比花",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "わグためにをきつと思ふ心地してまつ夜うれしき子規かな",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "待つかひいあらじと思ひし曉の空にきこゆるほとゝぎす哉",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "すむ人い心もとめぬう此花のかきねすぎうき山去なおさと",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "山ざとの桑n若葉に成にけりこがひはじめん夏きさるらし",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "ちり殘る花の木の間の春の月いまいく夜とり影かすむらん",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "春もはやふか田此こなぎ花さきて夕さりくれバ蛙むくなり",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "をしむらんいりの心い知らねどもたをらまほしき杜若りな",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "ふる里比垣ね比すみれ里の子の來て摘むものと成にける哉",
   "kana": "",
   "speaker": "",
   "page": 81,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "草も木もかさなびきする野づかさに嵐をわけて鹿ぞ鳴なる",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "さを鹿比鳴ねかなしく聞ゆなりをのゝ萩はら今りちるらん",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "聞玄らぬ虫もまじりて鳴までに〓が故〓いあれにけるかな",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "籠にりひて市北ちまさにおクせてもさても寂しき虫の聲哉",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "おもしろく尾花なみよる片岡い風をみるべきところんけり",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "枝をれバやつるゝ宿比秋萩も君グためにいいとはざりりと",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "とくおきて野守い見ぞや小萩原ちりぬばクりわ朝風のふく",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "枕邊にさしも近くい植ねどもたゞこゝもと比〓のうはかぜ",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "けふも猶夏の暑さにくれしかど月夜となれバ秋めきにタり",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "さら〓〓と園比若とク西ふきてふしよき程によい成にりり",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "いらゝけき實おなる物とみえぬ哉物はかなげ比さゝ栗北花",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "うなゐ子おちごいまかせて垂乳根の母い桑兒をひたす頃哉",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "竹の子いはやくも竹に成にけり親のたけおも立ならぶまで",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "蚊の聲ハ此頃たえし耳もとにさしあてヽなくきり〓〓を哉",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "行く人もわれより外いなかりけり田舍なはて比秋の夕ぐれ",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "よむふみもみえず成ぬる夕暮の我山まどHあき北さびしさ",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "かぼつかな立いでてみれバ霧こめて野も山もなき秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "なおは人袖さむからし打なびく草香のやま北秋のゆふかぜ",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "心さへふけバ玄をるヽ秋風を草木のみともおもひらるあな",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "中ぞらに月たけゆけバ庭松のかげいひきくも成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "山里いはればもあらぬうす霧におぼつかなくてふくる月哉",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "ま比ゝ浦の入江の尾花をりしきて浪のやてらを月を見し哉",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "誰もみる今宵此月をむかひゐて我物がほおおもひけるかお",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "みだるれバ又つらなりてあらましく西吹く空を雁鳴わさる",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "夕日さす豐はさ雲のをちかさに、打なびきたり雁のひとつら",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "聲をのみさやかに聞しさを鹿のたちども見えて月ぞ出にりる",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "わが山の松の秋風はざさむくふくゆふべより鹿ぞおきける",
   "kana": "",
   "speaker": "",
   "page": 82,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "耳もとに鳴く蚊の聲せうるさ〓〓我ふなよりそ思はぬ物を",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "夢比うちおあふとい君を見つれども物はりなくてやみにける哉",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "戀玄ながあはきとだおもいはましをなからん後い何あかいせん",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "後おだおおもひけりとも君知らバ死ん命もをしからなくに",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "いはじ唯いひ出て人のつれなくバいはぬあ增る物思やせん",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "ひるいきえよるいもゆなる夏虫比人と生れし我身ならまし",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "誰グせきていかなる方に流るらんこゝにいかれし中川の水",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "かくながらいひも出なで戀死なが世い常おしと歎かれんせみ",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "としつきをなれし心比せらるゝい心やかねて君とあひりん",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "露ばかりかゝる情になびきけりおもへバかろきわが心あな、",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "天地の神ふまかせてあられなバ我物おもひハ安けからまし",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "何事も今日をあすゐとゆづるは壮ゆづりがちあて過し年哉",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "ほたさきて何の昔り語るらんさし交りてもみまやしきりむ",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "夕まぐれせめてあはする荒鷹あ比がれぬ鳥の叫びてぞ飛ぶ",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "大井川波いおとをきかさぶちの松にさわぎて千鳥なくなり",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "風をぎてさ夜もふけひのひと浦い千鳥の聲に成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "宵のまい聞えざりしを角田川夜のふりゆけバ千鳥なくなり",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "さら〓〓とあぼれて落る音すなり雪比竹むら風さつらしも",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "山の端の雪け比雲をあながちに時雨となしてふくあらし哉",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "人にセグほこりし庭のも〓ぢぢハ嵐のものと成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "うつとしも見えぬこさめ比力にも散べき物と成れる木葉り",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "吹く風のさそふもまたでちる見れバ木葉も物の果い知どけり",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "ちるも比と思ふものから悲しきい嵐の庭比木のはなりりま",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "水かるゝ田の面の伏屋もりもてゝ人さへすまぬ秋比暮かな",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "よひ〓〓にほそる影こそ哀なれさてもいく夜ぞ秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "下葉ちる小萩グもとにこほろぎのなく聲聞りバ物ぞ悲しき",
   "kana": "",
   "speaker": "",
   "page": 83,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "いおといはん人をパ玄ひじやしま國妻まぎ兼し我ならおくお",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "恨とてもあひなき人の心ゆゑなくより外にせんかさもなし",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "來ぬものと思ひはてヽもねられぬいセグ魂や人をまつらん",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "こん世までちぎりし物を此世より今より人比忘れけるかな",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "道のべ比人のつまづくつぶら石かどおきものゝ憎くもある哉",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "わかれつる天と地との中空おひとり北てれり富士託玄ば山",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "のる駒のあむおふさび比見かへりにねぶり危ふき鞍の上哉",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "日數へてまよへる旅の衣手をさもあらけなくふくあらし哉",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "池水にねざしととめぬ浮草はうきながらさへ花いさきりり",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "あさと見バ國い八十國むつびなど國n八十國いづれりよけん",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "何事もむかし〓〓と思ひしい今の世玄らぬこゝろなりりり",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "わさ中のはなれ小島のひとつ松たグいつの世に種い蒔けん",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "たゞ一木比ごるとみてし古〓の松もかさ枝い枯にけるかな",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "おのグ世お千年をもたる蘆鶴いあゆみさへこそれどろかりろき",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "友よばふありそれ鶴の聲たかしおきに朝日比今りいづらん",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "家つ芋かけひの水にあらはせて人いおとせぬ山かどれいほ",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "山里、軒軒かかひひ比かさぶきてあらしにさゆる水の音かを",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "わがやどい軒端の椎比なかりせバ鳥も聲せぬ住家ならまし",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "琴とれびうき世比事い忘られつ心もことになるあゝちして",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "おもふあとおくてねざむる曉ぞおのぶまあと比心なりける",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "假そめにいでましにけるみ吉野のよし比やつひの大みや所",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "みよし野い北風さむくなりぬめり越の高根の雪みくだけふ",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "箱根ぢ比山ほとゝぎす時まちてをくの五月代空もとヾろに",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "降つもる雪れ〓山山高根よりみがのれいづるあき北夜の月",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "塚ひとつ寺のかさへに數そひて人いむおしときくぶ悲しさ",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "まさぐりし其玉の〓いさえねども人いむなしく成にける哉",
   "kana": "",
   "speaker": "",
   "page": 84,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  }
 ],
